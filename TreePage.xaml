<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="naidis_TARge25.TreePage"
             Title="Puu">

    <Grid RowDefinitions="55*,45*">

        <!--Ülemine osa: puu -->
        <AbsoluteLayout x:Name="TreeLayout"
                Grid.Row="0"
                BackgroundColor="LightSkyBlue">

            <BoxView Color="ForestGreen"
             AbsoluteLayout.LayoutBounds="0, 0.8, 1, 0.2"
             AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional" />

        </AbsoluteLayout>

        <!-- Alumine osa: juhtpaneel -->
        <ScrollView Grid.Row="1"
                    BackgroundColor="White">

            <VerticalStackLayout x:Name="ControlPanel"
                                 Spacing="5"
                                 Padding="10">
            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
